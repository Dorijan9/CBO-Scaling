{
  "random_seed": 42,
  "scm": {
    "observation_noise_variance": 0.3,
    "root_variance": 1.0,
    "intervention_value": 2.0,
    "n_observational_samples": 200,
    "n_interventional_samples_per_iter": 10
  },
  "weight_prior": {
    "mean": 0.0,
    "variance": 0.5
  },
  "graph_prior": {
    "temperature_tau": 3.0
  },
  "cbo": {
    "max_iterations": 10,
    "convergence_threshold": 0.95,
    "acquisition_function": "expected_information_gain",
    "n_eig_simulations": 50
  },
  "scaling": {
    "n_repeats": 20,
    "sizes": ["5var", "7var", "9var", "10var"]
  },
  "output": {
    "log_dir": "logs/",
    "plot_dir": "plots/"
  }
}
